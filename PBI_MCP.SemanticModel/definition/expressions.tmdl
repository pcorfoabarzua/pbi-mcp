/// Ruta del archivo Excel REPORTE PINV RECLUTAMIENTO.xlsx
expression RutaArchivoExcel = "c:\Users\felipe.abarzua\Desktop\workspace\PBI_Alejandra\data\REPORTE PINV RECLUTAMIENTO.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 946e123f-1cf7-4c5e-8d5b-60254b47e17a
