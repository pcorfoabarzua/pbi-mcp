	partition Fact_Captura_Lance = m
		mode: import
		queryGroup: 03_Hechos
		source =
				let
				    OrigenStagingC = Stg_C_PINV_PROPORCION_SP,
				    FiltrarFilasSinViajeNiLance = Table.SelectRows(OrigenStagingC, each [COD_BARCO] <> null),
				    CombinarConDimZona = Table.NestedJoin(FiltrarFilasSinViajeNiLance, {"ZONA_PINV"}, Dim_Zona, {"Zona_PINV"}, "ZonaDim", JoinKind.LeftOuter),
				    ExpandirIdZona = Table.ExpandTableColumn(CombinarConDimZona, "ZonaDim", {"ID_Zona"}, {"ID_Zona"}),
				    CombinarConDimEspecie = Table.NestedJoin(ExpandirIdZona, {"ESPECIE"}, Dim_Especie, {"Especie"}, "EspecieDim", JoinKind.LeftOuter),
				    ExpandirIdEspecie = Table.ExpandTableColumn(CombinarConDimEspecie, "EspecieDim", {"ID_Especie"}, {"ID_Especie"}),
				    AgregarClaveRegistroLance = Table.AddIndexColumn(ExpandirIdEspecie, "ID_Lance_Registro", 1, 1, Int64.Type),
				    SeleccionarYOrdenarColumnas = Table.SelectColumns(AgregarClaveRegistroLance, {
				        "ID_Lance_Registro", "ID_SEMANA", "ID_Zona", "ID_Especie", "COD_BARCO",
				        "COD_ESPECIE", "PUERTO_RECALADA", "COD_PESQUERIA", "ORIGEN_VIAJE",
				        "FECHA_HORA_RECALADA", "FECHA_LANCE", "NUMERO_LANCE_EX",
				        "LATITUD", "LONGITUD", "LAT", "LONG", "ESTADO_ESPECIMEN",
				        "FRECUENCIA", "PESO", "EJEM_POR_LITRO", "PESO_POR_LITRO",
				        "CAPTURA_VIAJE", "CAPTURA_VIAJE_LANCE_ESPECIE"
				    }),
				    RenombrarColumnasHechos = Table.RenameColumns(SeleccionarYOrdenarColumnas, {
				        {"ID_SEMANA", "ID_Semana"},
				        {"COD_BARCO", "Cod_Barco"},
				        {"COD_ESPECIE", "Cod_Especie"},
				        {"PUERTO_RECALADA", "Puerto_Recalada"},
				        {"COD_PESQUERIA", "Cod_Pesqueria"},
				        {"ORIGEN_VIAJE", "Origen_Viaje"},
				        {"FECHA_HORA_RECALADA", "Fecha_Hora_Recalada"},
				        {"FECHA_LANCE", "Fecha_Lance"},
				        {"NUMERO_LANCE_EX", "Numero_Lance_Ex"},
				        {"LATITUD", "Latitud_DMS"},
				        {"LONGITUD", "Longitud_DMS"},
				        {"LAT", "Latitud"},
				        {"LONG", "Longitud"},
				        {"ESTADO_ESPECIMEN", "Estado_Especimen"},
				        {"FRECUENCIA", "Frecuencia"},
				        {"PESO", "Peso"},
				        {"EJEM_POR_LITRO", "Ejem_Por_Litro"},
				        {"PESO_POR_LITRO", "Peso_Por_Litro"},
				        {"CAPTURA_VIAJE", "Captura_Viaje"},
				        {"CAPTURA_VIAJE_LANCE_ESPECIE", "Captura_Viaje_Lance_Especie"}
				    })
				in
				    RenombrarColumnasHechos

