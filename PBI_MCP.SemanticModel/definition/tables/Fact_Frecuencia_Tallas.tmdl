/// Tabla de hechos de frecuencia de tallas de reclutamiento (origen: hoja A_PINV RECL_R ).
table Fact_Frecuencia_Tallas
	lineageTag: 4194e204-7af8-45e7-86c8-25f7791daeb3

	column ID_Frecuencia
		dataType: int64
		isKey
		lineageTag: 060aef02-e37f-4091-b284-7f76e681a21b
