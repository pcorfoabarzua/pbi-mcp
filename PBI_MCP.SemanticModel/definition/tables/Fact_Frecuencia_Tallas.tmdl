	partition Fact_Frecuencia_Tallas = m
		mode: import
		queryGroup: 03_Hechos
		source =
				let
				    OrigenStagingA = Stg_A_PINV_RECL_R,
				    CombinarConDimZona = Table.NestedJoin(OrigenStagingA, {"ZONA_PINV"}, Dim_Zona, {"Zona_PINV"}, "ZonaDim", JoinKind.LeftOuter),
				    ExpandirIdZona = Table.ExpandTableColumn(CombinarConDimZona, "ZonaDim", {"ID_Zona"}, {"ID_Zona"}),
				    CombinarConDimEspecie = Table.NestedJoin(ExpandirIdZona, {"ESPECIE"}, Dim_Especie, {"Especie"}, "EspecieDim", JoinKind.LeftOuter),
				    ExpandirIdEspecie = Table.ExpandTableColumn(CombinarConDimEspecie, "EspecieDim", {"ID_Especie"}, {"ID_Especie"}),
				    AgregarClaveFrecuencia = Table.AddIndexColumn(ExpandirIdEspecie, "ID_Frecuencia", 1, 1, Int64.Type),
				    SeleccionarYOrdenarColumnas = Table.SelectColumns(AgregarClaveFrecuencia, {
				        "ID_Frecuencia", "ID_SEMANA", "ID_Zona", "ID_Especie",
				        "LONGITUD_MUESTRA", "TOTAL_INDIVIDUOS_LONG", "VOLUMEN_TOTAL_GLOBAL",
				        "FRECUENCIA_PONDERADA", "MODA", "OBSERVACION"
				    }),
				    RenombrarColumnasHechos = Table.RenameColumns(SeleccionarYOrdenarColumnas, {
				        {"ID_SEMANA", "ID_Semana"},
				        {"LONGITUD_MUESTRA", "Longitud_Muestra"},
				        {"TOTAL_INDIVIDUOS_LONG", "Total_Individuos_Long"},
				        {"VOLUMEN_TOTAL_GLOBAL", "Volumen_Total_Global"},
				        {"FRECUENCIA_PONDERADA", "Frecuencia_Ponderada"},
				        {"MODA", "Moda"},
				        {"OBSERVACION", "Observacion"}
				    })
				in
				    RenombrarColumnasHechos

