		isHidden
		lineageTag: b69a576e-cce5-4fff-a674-0fb16497e02e
		summarizeBy: none
		sourceColumn: ID_Semana

	column ID_Zona
		dataType: int64
		isHidden
		lineageTag: acf8e7b2-ebb7-429f-ac54-8372a9541553
		summarizeBy: none
		sourceColumn: ID_Zona

	column ID_Especie
